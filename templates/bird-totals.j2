{% extends "main.j2" %}
{% block content %}


<h1>Bird Totals</h1>

{#
#################################
########## Read Table ###########
#################################
#}
<table>
    <thead>
        {# The DB attribute names will be printed for the header row #}
        <tr>
            {% if birdslist|length > 0 %}
                {% for key in birdslists[0].keys() %}
                <th>{{ key }}</th>
                {% endfor %}
            {% else %}
                <th>birderName</th>
                <th>birdName</th>
                <th>totalCount</th>
            {% endif %}
        </tr>
    </thead>

    <tbody>
        {% for birdlist in birdslists %}
        <tr>
            <td>{{ birdlist.birderName }}</td>
            <td>{{ birdlist.birdName }}</td>
            <td>{{ birdlist.totalCount }}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}